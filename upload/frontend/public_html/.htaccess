<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^__api/?(.*)$ __api/index.php?__path=$1 [QSA,L]
  RewriteRule ^assets/index-C82v1HEh\.js$ assets/index-Bd7S9zKo.js [L]
  RewriteRule ^assets/index-B4vexp5m\.js$ assets/index-Bd7S9zKo.js [L]
  RewriteRule ^assets/index-D4bUdpkG\.js$ assets/index-Bd7S9zKo.js [L]
  RewriteRule ^assets/index-DTC_UlOB\.js$ assets/index-Bd7S9zKo.js [L]
  RewriteRule ^assets/index-DgMF9881\.js$ assets/index-Bd7S9zKo.js [L]
  RewriteRule ^assets/index-B0Hoe0wn\.css$ assets/index-D0lRlsOr.css [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg|png|jpg|jpeg|gif|woff2?|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>